<!-- Reguła 1: Wykrywanie włączenia konta gościa (Wsparcie języka polskiego i angielskiego) -->
  <group name="windows,windows_security,account_changed,adduser">
  <rule id="100050" level="10">
  <if_sid>60103</if_sid>
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4722$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(Gość|Guest)$</field>
    <description>Windows: The built-in Guest account was enabled (Target: $(win.eventdata.targetUserName)) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1078.001</id>
      <id>T1098</id>
    </mitre>
    <group>pci_dss_10.2.5,pci_dss_8.1.2,gdpr_IV_35.7.d,hipaa_164.312.a.2.I,</group>
  </rule>

</group>

<!-- Reguła 2: Wykrywanie ataku SSH Brute-Force (3 nieudane próby w 120s z tego samego IP) -->
<group name="local,syslog,sshd,authentication_failed,">
  <rule id="100101" level="10" frequency="3" timeframe="120">
  <if_matched_sid>5760</if_matched_sid>
  <same_source_ip />
  <description>Multiple SSH login failures from the same source IP</description>
  <mitre>
    <id>T1110</id>
  </mitre>
    <group>authentication_failed,ssh_bruteforce,credential_access,</group>
  </rule>
</group>
